    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Sample enquiries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  { json: { name: 'Ayesha', category: 'booking', message: 'Emergency appointment please' } },\n  { json: { name: 'Tom', category: 'pricing', message: 'How much is whitening?' } },\n  { json: { name: 'Maria', category: 'research', message: 'Just looking for now' } },\n  { json: { name: 'Sam', category: 'BOOKING', message: 'Case drift from an upstream form' } } ];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Is category clean?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.category }}",
              "rightValue": "^(booking|pricing|research)$",
              "operator": {
                "type": "string",
                "operation": "matches"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Normalise category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i => ({ json: { ...i.json, category: i.json.category.toLowerCase() } }));"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Route by category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "booking",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s1",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "booking",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true
            },
            {
              "outputKey": "pricing",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s2",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "pricing",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "other"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Draft booking reply",
