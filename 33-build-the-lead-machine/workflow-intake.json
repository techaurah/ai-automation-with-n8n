      ],
      "parameters": {
        "content": "## Non-negotiables in this file\nComplaints exit to a human before scoring. The dedupe register check from Lesson 19 belongs in the webhook door twin of this intake; the data model carries the contract.",
        "height": 180,
        "width": 420,
        "color": 4
      }
    }
