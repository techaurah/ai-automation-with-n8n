{
  "name": "Lesson 02 - First import (setup ping, scheduled)",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Daily ping",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Ping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ping: 'scheduled run OK', at: new Date().toISOString() } }];"
      }
    }
  ],
  "connections": {
    "Daily ping": {
      "main": [
        [
          {
            "node": "Ping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
