      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const u = $input.first().json;\nreturn [{ json: { name: u.name, email: u.email.toLowerCase(), city: u.address.city, company: u.company.name } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
