# Lesson 29: copy to .env, fill in, never commit the filled file.
DB_USER=n8n
DB_PASSWORD=choose-a-long-random-password
DB_NAME=n8n
# Generate once (openssl rand -hex 32) and back it up separately.
# Lose this key and your stored credentials are unreadable forever.
N8N_ENCRYPTION_KEY=replace-with-64-hex-characters
GENERIC_TIMEZONE=Europe/London
# The public URL the instance is reached at (drives webhook URLs).
WEBHOOK_URL=https://n8n.example.com/
