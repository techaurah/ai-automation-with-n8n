            },
            {
              "category": "pricing",
              "description": "Asks about prices, costs, offers, or payment."
            },
            {
              "category": "complaint",
              "description": "Unhappy, angry, or threatening escalation."
            }
          ]
        },
        "options": {
          "fallback": "other"
        }
